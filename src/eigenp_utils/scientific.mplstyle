# Figure properties
figure.figsize: 4, 4

# Font properties
font.family: cmr10, serif
font.size: 14
mathtext.fontset: cm
axes.unicode_minus: False
mathtext.fallback: stix

# Figure layout
figure.constrained_layout.use: False 

# SPINE COLORS  -- GRAY
axes.edgecolor:      2B2B2B
text.color:          2B2B2B
axes.labelcolor:     2B2B2B
xtick.color:         2B2B2B
ytick.color:         2B2B2B

# Axes properties
axes.linewidth: 2
axes.labelpad: 10
axes.prop_cycle: cycler(color=['008fd5', 'fc4f30', '6d904f', 'e5ae38', '8b8b8b', '810f7c'])
axes.spines.top:    False
axes.spines.right:  False

# Tick properties
# x-axis
xtick.top: False
xtick.direction: out
xtick.major.size: 4
xtick.major.width: 2
xtick.minor.size: 2.5    # minor ticks (visible on log axes): shorter and thinner than majors
xtick.minor.width: 1

# y-axis
ytick.right: False
ytick.direction: out
ytick.major.size: 4
ytick.major.width: 2
ytick.minor.size: 2.5    # minor ticks (visible on log axes): shorter and thinner than majors
ytick.minor.width: 1

# Line properties
lines.linewidth: 2

# Legend properties
# ~20% smaller than the base font, with a pale rounded frame so the box never reads as data
legend.fontsize: 11
legend.title_fontsize: 11
legend.markerscale: 0.8
legend.handlelength: 1.6
legend.handleheight: 0.56
legend.handletextpad: 0.6
legend.labelspacing: 0.4
legend.borderpad: 0.5
legend.frameon: True
legend.fancybox: True
legend.framealpha: 1
legend.facecolor: FFFFFF
legend.edgecolor: E3E3E3

# Grid Properies
axes.grid          : False
axes.grid.axis     : both    ## which axis the grid should apply to
axes.grid.which    : major   ## gridlines at {major, minor, both} ticks
grid.color     : 808080  ## grid color
grid.linestyle : :       ##  - solid
grid.alpha     : 0.5     ## transparency, between 0.0 and 1.0

#grid.linewidth : 0.8     ## in points
